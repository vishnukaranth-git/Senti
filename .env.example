# ==============================================================================
# SentinelMind Environment Configuration Template (.env.example)
# Copy this file to:
#   1. backend/.env (for FastAPI backend service)
#   2. frontend/.env (for React / Vite frontend client)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq High-Speed LLM Inference (Backend)
# ------------------------------------------------------------------------------
# Obtain API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 2. Vectorize Hindsight Agent Memory (Backend & Frontend)
# ------------------------------------------------------------------------------
# Obtain API key from: https://vectorize.io (or leave blank to use Local Memory Bank)
HINDSIGHT_API_KEY=hsk_your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=sentinelmind-incidents

# Frontend Hindsight endpoint (optional if querying memory through backend proxy)
VITE_HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# ------------------------------------------------------------------------------
# 3. Supabase Database, Auth & Row Level Security (Backend & Frontend)
# ------------------------------------------------------------------------------
# Obtain credentials from: https://supabase.com/dashboard/project/<project_ref>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_or_anon_key_here

# Frontend Vite client credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_public_anon_key_here

# ------------------------------------------------------------------------------
# 4. Backend Server Runtime Settings (Backend)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

